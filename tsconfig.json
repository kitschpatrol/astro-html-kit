{
	"extends": "@kitschpatrol/typescript-config/astro",
	"compilerOptions": {
		// Additions from Astro's strictest tsconfig
		// vs. the extended @kitschpatrol/typescript-config/astro
		"types": ["node"],
		"allowUnusedLabels": false
	},
	"include": [
		"**/*",
		"**/**.*",
		".astro/types.d.ts",
		"./playground-starlight/.astro/types.d.ts",
		"./playground/.astro/types.d.ts"
	],
	"exclude": [
		"**/dist/",
		"**/bin/",
		"**/node_modules/",
		"./.astro",
		"./playground/.astro",
		"./playground/astro.config.ts"
	],
	"mdx": {
		"plugins": ["remark-directive", "remark-attribute-list"]
	}
}
