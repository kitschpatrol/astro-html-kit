{
	"name": "astro-html-kit",
	"version": "0.5.1",
	"description": "Astro integration and middleware to clean up your HTML.",
	"keywords": [
		"astro",
		"astro-integration",
		"astro-component",
		"html",
		"middleware",
		"dom",
		"npm-package"
	],
	"homepage": "https://github.com/kitschpatrol/astro-html-kit",
	"bugs": "https://github.com/kitschpatrol/astro-html-kit/issues",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/kitschpatrol/astro-html-kit.git"
	},
	"license": "MIT",
	"author": {
		"name": "Eric Mika",
		"email": "eric@ericmika.com",
		"url": "https://ericmika.com"
	},
	"sideEffects": true,
	"type": "module",
	"exports": {
		".": "./src/index.ts",
		"./middleware": "./src/middleware.ts"
	},
	"files": [
		"src",
		"!src/pages"
	],
	"scripts": {
		"build": "pnpm astro sync && pnpm run -r astro sync",
		"clean": "shx rm -f pnpm-lock.yaml && git clean -fdX -e !.claude/",
		"dev": "pnpm -C playground run dev",
		"dev-starlight": "pnpm -C playground-starlight run dev",
		"fix": "ksc fix",
		"lint": "ksc lint && pnpm run -r --include-workspace-root astro check",
		"release": "bumpp --commit 'Release: %s' && pnpm build && NPM_AUTH_TOKEN=$(op read 'op://Personal/npm/token') pnpm publish",
		"test": "vitest run"
	},
	"dependencies": {
		"linkedom": "^0.18.13"
	},
	"devDependencies": {
		"@astrojs/check": "^0.9.10",
		"@kitschpatrol/shared-config": "^8.6.0",
		"@types/node": "~24.13.3",
		"astro": "^7.1.6",
		"bumpp": "^12.1.1",
		"node-addon-api": "^8.9.0",
		"node-gyp": "^13.0.1",
		"shx": "^0.4.0",
		"typescript": "~6.0.3",
		"vitest": "^4.1.10"
	},
	"peerDependencies": {
		"astro": "^7.0.0"
	},
	"packageManager": "pnpm@11.18.0",
	"engines": {
		"node": ">=24.16.0"
	}
}
