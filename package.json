{
	"name": "astro-html-kit",
	"version": "0.6.0",
	"description": "Astro integration and middleware to clean up your HTML.",
	"keywords": [
		"astro",
		"astro-integration",
		"astro-component",
		"html",
		"middleware",
		"dom",
		"npm-package"
	],
	"homepage": "https://github.com/kitschpatrol/astro-html-kit",
	"bugs": "https://github.com/kitschpatrol/astro-html-kit/issues",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/kitschpatrol/astro-html-kit.git"
	},
	"license": "MIT",
	"author": {
		"name": "Eric Mika",
		"email": "eric@ericmika.com",
		"url": "https://ericmika.com"
	},
	"sideEffects": false,
	"type": "module",
	"exports": {
		".": "./src/index.ts",
		"./middleware": "./src/middleware.ts"
	},
	"files": [
		"src",
		"!src/pages"
	],
	"scripts": {
		"build": "pnpm astro sync && pnpm run -r astro sync",
		"clean-deep": "shx rm -f pnpm-lock.yaml && git clean -fdX",
		"dev": "pnpm -C playground run dev",
		"dev-starlight": "pnpm -C playground-starlight run dev",
		"fix": "ksc fix",
		"lint": "ksc lint && pnpm run -r --include-workspace-root astro check",
		"prepare": "pnpm build",
		"release": "bumpp --commit 'Release: %s' --all --execute 'chagent --root-changelog package --skip-package playground*' && pnpm build && pnpm publish --otp $(op item get npm --otp)",
		"test": "vitest run"
	},
	"dependencies": {
		"linkedom": "^0.18.15"
	},
	"devDependencies": {
		"@astrojs/check": "^0.9.12",
		"@kitschpatrol/chagent": "0.5.0",
		"@kitschpatrol/shared-config": "^8.14.1",
		"@types/node": "~24.13.6",
		"astro": "^7.4.7",
		"bumpp": "^12.3.0",
		"shx": "^0.4.0",
		"typescript": "~6.0.3",
		"vitest": "^5.1.0"
	},
	"peerDependencies": {
		"astro": "^7.4.7"
	},
	"packageManager": "pnpm@12.18.0",
	"engines": {
		"node": "^24.16.0 || >=26.3.0"
	}
}
